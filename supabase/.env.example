# Local development secrets for `supabase start` (copied to supabase/.env).
# Real values for staging/production are set with `supabase secrets set`.
WORKER_SECRET=local-dev-worker-secret-change-me
# sandbox (no network, for local/staging) or meta_cloud (WhatsApp Cloud API via BSP)
WHATSAPP_PROVIDER=sandbox
WHATSAPP_APP_SECRET=local-sandbox-app-secret
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=local-verify-token
# Leave empty to use the deterministic rule-based fallback agent locally.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
RESEND_API_KEY=
EMAIL_FROM=AI Sales OS <noreply@example.com>
APP_URL=http://localhost:3000
GOOGLE_PLACES_API_KEY=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=dummy-local-only
